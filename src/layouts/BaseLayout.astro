---
/**
 * Page shell shared by every page. OWNER: platform.
 * Page features render into the default slot; extra <head> tags go in slot="head".
 * No inline <script> and no inline <style>/style="" anywhere (strict CSP).
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/chrome.css";
import "../styles/print.css";
import fontDisplay from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url";

import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { CHROME, SITE_NAME, THEME_COLOR } from "../content/site.ts";
import { buildHead, absoluteUrl, pageTitle } from "../lib/seo.ts";
import { serializeLd, type JsonLd } from "../lib/jsonld.ts";
import { OG_LOCALE, type Locale, type PageId } from "../lib/i18n.ts";

interface Props {
  locale: Locale;
  /** Page registry id (src/lib/i18n.ts). Omit for pages outside the registry (404). */
  page?: PageId;
  title: string;
  description: string;
  noindex?: boolean;
  /** JSON-LD nodes; `[[…]]` fields are stripped, `@context` is added. */
  jsonLd?: readonly JsonLd[];
  /** Root-relative OG image path. */
  ogImage?: string;
}

const { locale, page, title, description, noindex = false, jsonLd = [], ogImage } = Astro.props;
const chrome = CHROME[locale];
const head = page
  ? buildHead({ page, locale, title, description, noindex, ogImage })
  : undefined;
const fullTitle = head?.title ?? pageTitle(title);
const ogImageUrl = head?.ogImage ?? absoluteUrl(ogImage ?? `/og-${locale}.png`);
const ldBlocks = serializeLd(jsonLd);
/** The share card is the name and role set in type: its alt is the page title. */
const ogImageAlt = fullTitle;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || !head ? "noindex, follow" : head.robots} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="color-scheme" content="light" />
    {head && <link rel="canonical" href={head.canonical} />}
    {head?.alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {head && <meta property="og:url" content={head.canonical} />}
    <meta property="og:locale" content={head?.ogLocale ?? OG_LOCALE[locale]} />
    {head?.ogAlternateLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {ldBlocks.map((json) => <script type="application/ld+json" set:html={json} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{chrome.skipLink}</a>
    <SiteHeader locale={locale} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
