---
/**
 * Home page (FR). OWNER: home UI. Contract: `home` is a `Home` (src/content/types.ts);
 * the nav anchors in src/content/site.ts expect the ids travaux, a-propos, cv, contact (offres sits just above contact).
 * Every string comes from `home` (or ./labels.ts for fixed UI wording).
 */
import type { Home } from "../../content/types.ts";
import About from "./About.astro";
import Contact from "./Contact.astro";
import CvTeaser from "./CvTeaser.astro";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import Work from "./Work.astro";
import { labelsFor } from "./labels.ts";
import "./home.css";

interface Props {
  home: Home;
}

const { home } = Astro.props;
const CV_HREF = labelsFor(Astro.url.pathname).cv.viewHref;
---

<div class="home">
  <Hero hero={home.hero} cases={home.work.cases} workHeading={home.work.heading} />
  <Work work={home.work} />
  <About about={home.about} />
  <CvTeaser cvteaser={home.cvteaser} viewHref={CV_HREF} downloadHref={home.hero.ctaSecondary.href} />
  <Services services={home.services} />
  <Contact contact={home.contact} no="04" />
</div>
<script>
  import "./reveal.ts";
</script>
