---
/** Decorative arrow (the webfont has none). `dir` rotates it through a class. */
interface Props {
  dir?: "right" | "up-right" | "down";
  class?: string;
}
const { dir = "right", class: className } = Astro.props;
---

<svg
  class:list={["arrow", `arrow--${dir}`, className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 12h15M13 6l6 6-6 6"></path>
</svg>
