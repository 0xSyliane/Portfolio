---
/**
 * CV page (web + print source of the PDF). The page wrappers pass `facts`
 * (language-independent) + `copy` (this locale); `buildCvView` joins them by id.
 * DOM order = reading order: header, profile, experience and projects, then the side
 * column (education, skills, languages, links). Real text everywhere, no images.
 */
import "./cv.css";
import { CHROME } from "../../content/site.ts";
import { switchTarget, type Locale } from "../../lib/i18n.ts";
import { rich } from "../../lib/rich.ts";
import type { CvCopy, CvFacts } from "../../content/types.ts";
import CvEntry from "./CvEntry.astro";
import CvSide from "./CvSide.astro";
import { buildCvView } from "./model.ts";

interface Props {
  locale: Locale;
  facts: CvFacts;
  copy: CvCopy;
}

const { locale, facts, copy } = Astro.props;
const view = buildCvView(facts, copy, locale);
const other = switchTarget("cv", locale);
const { switchLabel, todoLabel } = CHROME[locale];
---

<article class="wrap page-main cv">
  <header class="cv-head">
    <p class="cv-kicker mono">CV · {view.place}</p>
    <h1 class="cv-name">{view.name}</h1>
    <p class="cv-headline" set:html={rich(view.headline, todoLabel)} />
    <p class="cv-tools no-print">
      <a class="cv-button" href={copy.downloadPdf.href} download>
        <span class="cv-button__ref mono" aria-hidden="true">PDF</span>
        <span>{copy.downloadPdf.label}</span>
      </a>
      {
        other && (
          <a class="cv-switch mono" href={other.path} hreflang={other.locale} lang={other.locale}>
            {switchLabel}
          </a>
        )
      }
    </p>
  </header>

  <div class="cv-body">
    <div class="cv-main">
      <section class="cv-section" aria-labelledby="cv-profile">
        <h2 class="cv-h2" id="cv-profile">{copy.headings.profile}</h2>
        <p class="cv-summary" set:html={rich(view.summary, todoLabel)} />
      </section>

      <section class="cv-section" aria-labelledby="cv-projects">
        <h2 class="cv-h2" id="cv-projects">{copy.headings.projects}</h2>
        <ol class="cv-entries" role="list">
          {view.entries.map((entry) => <CvEntry entry={entry} todoLabel={todoLabel} />)}
        </ol>
      </section>


    </div>

    <CvSide locale={locale} view={view} copy={copy} email={facts.email} todoLabel={todoLabel} />
  </div>
</article>
