---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CvPage from "../../../features/cv/CvPage.astro";
import { cvFacts } from "../../../content/cv/facts.ts";
import { cvEn as copy } from "../../../content/cv/en.ts";
import { personLd } from "../../../lib/jsonld.ts";
---

<BaseLayout
  locale="en"
  page="cv"
  title={copy.meta.title}
  description={copy.meta.description}
  jsonLd={[personLd({ jobTitle: copy.headline, city: cvFacts.profile.city })]}
>
  <CvPage locale="en" facts={cvFacts} copy={copy} />
</BaseLayout>
