---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CvPage from "../../../features/cv/CvPage.astro";
import { cvFacts } from "../../../content/cv/facts.ts";
import { cvFr as copy } from "../../../content/cv/fr.ts";
import { knowsAboutFrom, personLd } from "../../../lib/jsonld.ts";
---

<BaseLayout
  locale="fr"
  page="cv"
  title={copy.meta.title}
  description={copy.meta.description}
  jsonLd={[personLd({ jobTitle: copy.headline, city: cvFacts.profile.city, knowsAbout: knowsAboutFrom(cvFacts) })]}
>
  <CvPage locale="fr" facts={cvFacts} copy={copy} />
</BaseLayout>
