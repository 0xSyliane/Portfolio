---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePage from "../../features/home/HomePage.astro";
import { homeFr } from "../../content/home.fr.ts";
import { caseStudyLd, personLd, webSiteLd } from "../../lib/jsonld.ts";

const caseNodes = homeFr.work.cases.map(caseStudyLd).filter((n) => n !== undefined);
---

<BaseLayout
  locale="fr"
  page="home"
  title={homeFr.meta.title}
  description={homeFr.meta.description}
  jsonLd={[
    personLd({ jobTitle: homeFr.hero.role }),
    webSiteLd("fr"),
    ...caseNodes,
  ]}
>
  <HomePage home={homeFr} />
</BaseLayout>
