---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { rich } from "../../../lib/rich.ts";

/** Legal notice (LCEN-style). Owner: platform; the facts are placeholders until confirmed. */
const sections = [
  {
    id: "editeur",
    title: "Éditeur du site",
    body: "Nom civil\u00a0: Syliane Sofiane Saad Bouzid.\nNom d'usage\u00a0: Syliane Saadbouzid, auto-entrepreneur, Alger (Algérie).\nContact : voir la section Contact de la [page d'accueil](/fr/#contact).\nDirecteur de la publication : Syliane Saadbouzid.",
  },
  {
    id: "hebergeur",
    title: "Hébergeur",
    body: "Vercel Inc., 340 S Lemon Ave #4133, Walnut, CA 91789, États-Unis. Site : [vercel.com](https://vercel.com).",
  },
  {
    id: "donnees",
    title: "Données personnelles",
    body: "Ce site n'utilise ni cookie, ni outil de mesure d'audience, ni formulaire. Le site ne collecte aucune donnée personnelle. Comme pour tout site web, l'hébergeur peut enregistrer des journaux techniques de connexion (adresse IP, date, page demandée). Si vous m'écrivez par e-mail, votre message n'est utilisé que pour vous répondre.",
  },
  {
    id: "propriete",
    title: "Propriété intellectuelle",
    body: "Textes, code et visuels du site : © Syliane Saadbouzid, tous droits réservés. Les marques citées appartiennent à leurs propriétaires.",
  },
] as const;
---

<BaseLayout
  locale="fr"
  page="legal"
  title="Mentions légales"
  description="Mentions légales du site de Syliane Saadbouzid : éditeur, hébergeur, données personnelles et propriété intellectuelle."
>
  <div class="wrap page-main">
    <h1>Mentions légales</h1>
    {
      sections.map((s) => (
        <section aria-labelledby={`legal-${s.id}`}>
          <h2 id={`legal-${s.id}`}>{s.title}</h2>
          <p set:html={rich(s.body)} />
        </section>
      ))
    }
  </div>
</BaseLayout>
